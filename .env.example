# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit real secrets in `.env` — it is excluded via .gitignore.

# The .env file is used automatically in two places:
#   1. docker compose up  -> Compose interpolates ${...} from .env
#   2. mvn spring-boot:run -> Spring Boot loads .env via spring.config.import
# OS environment variables always take precedence over .env values.

# PostgreSQL container password (docker-compose.yml reads this).
# The app uses the same value locally via SPRING_DATASOURCE_PASSWORD below.
POSTGRES_DB=url_shortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Spring Boot / backend configuration (non-Docker local runs)
# Keep this equal to POSTGRES_PASSWORD for the default setup.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/url_shortener
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Public base URL used to build short URLs
APP_BASE_URL=http://localhost:8080

# JWT signing secret — MUST be set, the app refuses to start without it.
# Put a long random value here (>= 32 bytes for HS256). It is read from .env
# by both `mvn spring-boot:run` and `docker compose up`.
JWT_SECRET=
